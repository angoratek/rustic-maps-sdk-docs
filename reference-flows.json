{
  "schema_version": 1,
  "artifact": {
    "name": "reference-flows",
    "purpose": "The ordered reference-application flows every target must run, with the visible outcome, copy ID and automation hook of each step (docs/design/ReferenceApplicationBehavior.md)."
  },
  "schema_documentation": {
    "flow": "flow_id, label, scenario, screenshot_step_id (a step ID, or null when the flow is not the screenshot scenario), screenshot_frames (the published frame set on the reference flow), preconditions, steps",
    "step": "step_id, action, outcomes, hooks",
    "action": "kind plus the fields that kind uses: field (origin|destination), value, target, provider_key",
    "outcome": "kind (state|visible|condition|copy) and id; state IDs come from states, copy IDs from platform/reference-tokens.json ui_labels, visible and condition IDs from component_vocabulary",
    "hook": "kind (test_tag|accessibility_identifier|test_id|css_selector|not_available), value, and an optional pending+reason pair while a platform slice has not added the stable identifier yet; not_available always carries a reason"
  },
  "states": [
    {
      "id": "home_peek",
      "description": "the home sheet's peek"
    },
    {
      "id": "plan_search",
      "description": "the two-field search view"
    },
    {
      "id": "planning",
      "description": "a plan request is in flight"
    },
    {
      "id": "route_planned",
      "description": "a route is present and can start"
    },
    {
      "id": "navigating",
      "description": "a simulated or device-driven trip is running"
    },
    {
      "id": "arrived",
      "description": "the trip reached its end"
    },
    {
      "id": "provider_settings",
      "description": "the provider-settings overlay"
    },
    {
      "id": "diagnostics",
      "description": "the diagnostics overlay"
    }
  ],
  "component_vocabulary": [
    {
      "id": "home_sheet_peek",
      "description": "the home sheet in its peek state"
    },
    {
      "id": "search_view",
      "description": "the two-field search view"
    },
    {
      "id": "origin_result_row",
      "description": "a provider result row belonging to the origin field"
    },
    {
      "id": "destination_result_row",
      "description": "a provider result row belonging to the destination field"
    },
    {
      "id": "route_card",
      "description": "the route summary card with distance, duration, mode and strategy"
    },
    {
      "id": "turn_banner",
      "description": "the top-center turn banner"
    },
    {
      "id": "route_polyline",
      "description": "the planned route polyline on the map"
    },
    {
      "id": "eta_line",
      "description": "the navigation drawer's ETA-distance line"
    },
    {
      "id": "speed_controls",
      "description": "the playback speed chips"
    },
    {
      "id": "first_instruction_shown",
      "description": "the turn banner names the first instruction of the trip"
    },
    {
      "id": "navigation_speed_one",
      "description": "the 1x playback-speed chip is selected"
    },
    {
      "id": "vector_base",
      "description": "the styled vector base with its place labels"
    },
    {
      "id": "provider_settings_sheet",
      "description": "the provider-settings surface"
    },
    {
      "id": "provider_routing_row",
      "description": "the settings routing capability row"
    },
    {
      "id": "diagnostics_pane",
      "description": "the diagnostics surface"
    },
    {
      "id": "diagnostics_event_list",
      "description": "the diagnostics pane's bounded event list"
    },
    {
      "id": "readiness_chip",
      "description": "the readiness chip that opens diagnostics"
    },
    {
      "id": "settings_close_control",
      "description": "the settings surface's close control"
    },
    {
      "id": "plan_route_action",
      "description": "the explicit Plan route action"
    },
    {
      "id": "plan_ready",
      "description": "both plan fields hold text, so Plan route is enabled"
    },
    {
      "id": "origin_field_filled",
      "description": "my location filled the origin field"
    },
    {
      "id": "destination_field_filled",
      "description": "my location filled the destination field"
    },
    {
      "id": "no_plan_triggered",
      "description": "no route was planned or started"
    },
    {
      "id": "diagnostics_inactive",
      "description": "no diagnostics subscription exists before the pane opens"
    },
    {
      "id": "diagnostics_bounded_window",
      "description": "the pane shows the most recent bounded window"
    },
    {
      "id": "debug_detail_enabled",
      "description": "the explicit debug-detail switch is on"
    },
    {
      "id": "diagnostics_list_cleared",
      "description": "the diagnostics display list is empty"
    },
    {
      "id": "provider_route_selected",
      "description": "the selected provider serves the routing capability"
    },
    {
      "id": "route_endpoint_reported",
      "description": "the routing row reports the demo endpoint and ready state"
    }
  ],
  "action_kinds": [
    "launch",
    "open_search",
    "type_and_search",
    "assign_result",
    "my_location",
    "plan_route",
    "tap",
    "open_settings",
    "select_provider",
    "wait_for_state",
    "verify"
  ],
  "platforms": {
    "android": {
      "display_name": "Android",
      "hook_kind": "test_tag",
      "source_paths": [
        "platform/android/reference-application/src/main"
      ],
      "build_input": {
        "path": "platform/android/reference-application/build.gradle.kts",
        "mechanism": "Gradle asset copy"
      }
    },
    "ios": {
      "display_name": "iOS",
      "hook_kind": "accessibility_identifier",
      "source_paths": [
        "platform/ios/reference-application/Sources"
      ],
      "build_input": {
        "path": "platform/ios/reference-application/project.yml",
        "mechanism": "SwiftPM resource"
      }
    },
    "react_native": {
      "display_name": "React Native",
      "hook_kind": "test_id",
      "source_paths": [
        "platform/rn/app-shell/App.tsx",
        "platform/rn/app-shell/src"
      ],
      "build_input": {
        "path": "platform/rn/app-shell/src/referenceFlows.ts",
        "mechanism": "Metro require"
      }
    },
    "web": {
      "display_name": "WebAssembly",
      "hook_kind": "css_selector",
      "source_paths": [
        "platform/web/index.html",
        "platform/web/playground.mjs"
      ],
      "build_input": {
        "path": "platform/web/serve.mjs",
        "mechanism": "same-origin route"
      }
    }
  },
  "flows": [
    {
      "flow_id": "plan_and_navigate",
      "label": "Search, plan and simulate",
      "scenario": "reference",
      "screenshot_step_id": "drive",
      "screenshot_frames": ["plan_sheet", "provider_section", "navigation", "vector_base"],
      "preconditions": [
